@page "/users"
@using ADScimApi.SCIM.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<Users> Logger

<PageTitle>Users</PageTitle>

<h1>Active Directory Users</h1>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="() => ShowUserModal(new ScimUser())">Add New User</button>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Search users..." @bind="searchTerm" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="SearchUsers">Search</button>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (users == null || !users.Resources.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Display Name</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users.Resources)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.DisplayName</td>
                        <td>@(user.Emails?.FirstOrDefault()?.Value ?? "-")</td>
                        <td>
                            @if (user.Active)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => ShowUserModal(user)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Math.Ceiling((double)users.TotalResults / pageSize); i++)
            {
                var pageNumber = i;
                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                    <button class="page-link" @onclick="() => LoadPage(pageNumber)">@pageNumber</button>
                </li>
            }
        </ul>
    </nav>
}

@if (showModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(string.IsNullOrEmpty(currentUser.Id) ? "Add New User" : "Edit User")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentUser" OnValidSubmit="SaveUser">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="userName" class="form-label">Username</label>
                            <InputText id="userName" class="form-control" @bind-Value="currentUser.UserName" />
                        </div>

                        <div class="mb-3">
                            <label for="displayName" class="form-label">Display Name</label>
                            <InputText id="displayName" class="form-control" @bind-Value="currentUser.DisplayName" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="givenName" class="form-label">First Name</label>
                                @if (currentUser.Name == null)
                                {
                                    currentUser.Name = new ScimName();
                                }
                                <InputText id="givenName" class="form-control" @bind-Value="currentUser.Name.GivenName" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="familyName" class="form-label">Last Name</label>
                                <InputText id="familyName" class="form-control" @bind-Value="currentUser.Name.FamilyName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" class="form-control" @bind-Value="email" />
                        </div>

                        @if (string.IsNullOrEmpty(currentUser.Id))
                        {
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="password" />
                            </div>
                        }

                        <div class="mb-3 form-check">
                            <InputCheckbox id="active" class="form-check-input" @bind-Value="currentUser.Active" />
                            <label class="form-check-label" for="active">Active</label>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private ScimListResponse<ScimUser>? users;
    private ScimUser currentUser = new();
    private bool showModal = false;
    private bool loading = true;
    private string searchTerm = "";
    private string email = "";
    private string password = "";
    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        loading = true;
        try
        {
            users = await Http.GetFromJsonAsync<ScimListResponse<ScimUser>>($"/scim/v2/Users?startIndex={((currentPage - 1) * pageSize) + 1}&count={pageSize}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading users");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadPage(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    private async Task SearchUsers()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadUsers();
            return;
        }

        loading = true;
        try
        {
            users = await Http.GetFromJsonAsync<ScimListResponse<ScimUser>>($"/scim/v2/Users?filter=userName co \"{searchTerm}\" or displayName co \"{searchTerm}\"&startIndex=1&count={pageSize}");
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching users");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowUserModal(ScimUser user)
    {
        currentUser = user;
        
        // Set email if available
        email = user.Emails?.FirstOrDefault()?.Value ?? "";
        
        // Reset password field
        password = "";
        
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveUser()
    {
        try
        {
            // Set email if provided
            if (!string.IsNullOrWhiteSpace(email))
            {
                currentUser.Emails = new List<ScimEmail>
                {
                    new ScimEmail
                    {
                        Value = email,
                        Type = "work",
                        Primary = true
                    }
                };
            }

            // Set password if provided (for new users)
            if (!string.IsNullOrWhiteSpace(password))
            {
                currentUser.Password = password;
            }

            if (string.IsNullOrEmpty(currentUser.Id))
            {
                // Create new user
                await Http.PostAsJsonAsync("/scim/v2/Users", currentUser);
            }
            else
            {
                // Update existing user
                await Http.PutAsJsonAsync($"/scim/v2/Users/{currentUser.Id}", currentUser);
            }

            CloseModal();
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving user");
        }
    }

    private async Task DeleteUser(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user?"))
        {
            return;
        }

        try
        {
            await Http.DeleteAsync($"/scim/v2/Users/{id}");
            await LoadUsers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting user");
        }
    }
}