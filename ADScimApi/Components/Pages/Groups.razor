@page "/groups"
@using ADScimApi.SCIM.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<Groups> Logger

<PageTitle>Groups</PageTitle>

<h1>Active Directory Groups</h1>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="() => ShowGroupModal(new ScimGroup())">Add New Group</button>
    </div>
    <div class="col-md-4">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Search groups..." @bind="searchTerm" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="SearchGroups">Search</button>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (groups == null || !groups.Resources.Any())
{
    <div class="alert alert-info">No groups found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Display Name</th>
                    <th>Members</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in groups.Resources)
                {
                    <tr>
                        <td>@group.DisplayName</td>
                        <td>@(group.Members?.Count ?? 0) members</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => ShowGroupModal(group)">Edit</button>
                            <button class="btn btn-sm btn-info me-1" @onclick="() => ShowMembersModal(group)">Members</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteGroup(group.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Math.Ceiling((double)groups.TotalResults / pageSize); i++)
            {
                var pageNumber = i;
                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                    <button class="page-link" @onclick="() => LoadPage(pageNumber)">@pageNumber</button>
                </li>
            }
        </ul>
    </nav>
}

@if (showGroupModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(string.IsNullOrEmpty(currentGroup.Id) ? "Add New Group" : "Edit Group")</h5>
                    <button type="button" class="btn-close" @onclick="CloseGroupModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentGroup" OnValidSubmit="SaveGroup">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="displayName" class="form-label">Display Name</label>
                            <InputText id="displayName" class="form-control" @bind-Value="currentGroup.DisplayName" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseGroupModal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (showMembersModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Group Members: @currentGroup.DisplayName</h5>
                    <button type="button" class="btn-close" @onclick="CloseMembersModal"></button>
                </div>
                <div class="modal-body">
                    @if (loadingMembers)
                    {
                        <div class="d-flex justify-content-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label for="addMember" class="form-label">Add Member</label>
                            <div class="input-group">
                                <select class="form-select" id="addMember" @bind="selectedUserId">
                                    <option value="">Select a user...</option>
                                    @if (availableUsers != null)
                                    {
                                        @foreach (var user in availableUsers.Resources)
                                        {
                                            <option value="@user.Id">@user.DisplayName (@user.UserName)</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-outline-primary" type="button" @onclick="AddMemberToGroup">Add</button>
                            </div>
                        </div>

                        @if (currentGroup.Members == null || !currentGroup.Members.Any())
                        {
                            <div class="alert alert-info">This group has no members.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Display Name</th>
                                            <th>Type</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var member in currentGroup.Members)
                                        {
                                            <tr>
                                                <td>@member.Display</td>
                                                <td>@member.Type</td>
                                                <td>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => RemoveMemberFromGroup(member.Value)">Remove</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseMembersModal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private ScimListResponse<ScimGroup>? groups;
    private ScimListResponse<ScimUser>? availableUsers;
    private ScimGroup currentGroup = new();
    private bool showGroupModal = false;
    private bool showMembersModal = false;
    private bool loading = true;
    private bool loadingMembers = false;
    private string searchTerm = "";
    private string selectedUserId = "";
    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        loading = true;
        try
        {
            groups = await Http.GetFromJsonAsync<ScimListResponse<ScimGroup>>($"/scim/v2/Groups?startIndex={((currentPage - 1) * pageSize) + 1}&count={pageSize}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading groups");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadPage(int page)
    {
        currentPage = page;
        await LoadGroups();
    }

    private async Task SearchGroups()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            await LoadGroups();
            return;
        }

        loading = true;
        try
        {
            groups = await Http.GetFromJsonAsync<ScimListResponse<ScimGroup>>($"/scim/v2/Groups?filter=displayName co \"{searchTerm}\"&startIndex=1&count={pageSize}");
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error searching groups");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowGroupModal(ScimGroup group)
    {
        currentGroup = group;
        showGroupModal = true;
    }

    private void CloseGroupModal()
    {
        showGroupModal = false;
    }

    private async Task SaveGroup()
    {
        try
        {
            if (string.IsNullOrEmpty(currentGroup.Id))
            {
                // Create new group
                await Http.PostAsJsonAsync("/scim/v2/Groups", currentGroup);
            }
            else
            {
                // Update existing group
                await Http.PutAsJsonAsync($"/scim/v2/Groups/{currentGroup.Id}", currentGroup);
            }

            CloseGroupModal();
            await LoadGroups();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving group");
        }
    }

    private async Task DeleteGroup(string id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this group?"))
        {
            return;
        }

        try
        {
            await Http.DeleteAsync($"/scim/v2/Groups/{id}");
            await LoadGroups();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting group");
        }
    }

    private async Task ShowMembersModal(ScimGroup group)
    {
        currentGroup = group;
        loadingMembers = true;
        showMembersModal = true;

        try
        {
            // Load the full group with members
            var fullGroup = await Http.GetFromJsonAsync<ScimGroup>($"/scim/v2/Groups/{group.Id}");
            if (fullGroup != null)
            {
                currentGroup = fullGroup;
            }

            // Load available users
            availableUsers = await Http.GetFromJsonAsync<ScimListResponse<ScimUser>>("/scim/v2/Users?count=100");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading group members");
        }
        finally
        {
            loadingMembers = false;
        }
    }

    private void CloseMembersModal()
    {
        showMembersModal = false;
    }

    private async Task AddMemberToGroup()
    {
        if (string.IsNullOrEmpty(selectedUserId))
        {
            return;
        }

        try
        {
            // Find the selected user
            var user = availableUsers?.Resources.FirstOrDefault(u => u.Id == selectedUserId);
            if (user == null)
            {
                return;
            }

            // Check if user is already a member
            if (currentGroup.Members?.Any(m => m.Value == selectedUserId) == true)
            {
                return;
            }

            // Create patch operation to add member
            var patchRequest = new ScimPatchRequest
            {
                Operations = new List<ScimPatchOperation>
                {
                    new ScimPatchOperation
                    {
                        Op = "add",
                        Path = "members",
                        Value = new List<ScimMemberRef>
                        {
                            new ScimMemberRef
                            {
                                Value = user.Id,
                                Display = user.DisplayName ?? user.UserName,
                                Type = "User"
                            }
                        }
                    }
                }
            };

            await Http.PatchAsJsonAsync($"/scim/v2/Groups/{currentGroup.Id}", patchRequest);

            // Refresh the group
            var updatedGroup = await Http.GetFromJsonAsync<ScimGroup>($"/scim/v2/Groups/{currentGroup.Id}");
            if (updatedGroup != null)
            {
                currentGroup = updatedGroup;
            }

            selectedUserId = "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error adding member to group");
        }
    }

    private async Task RemoveMemberFromGroup(string? memberId)
    {
        if (string.IsNullOrEmpty(memberId))
        {
            return;
        }

        try
        {
            // Create patch operation to remove member
            var patchRequest = new ScimPatchRequest
            {
                Operations = new List<ScimPatchOperation>
                {
                    new ScimPatchOperation
                    {
                        Op = "remove",
                        Path = $"members[value eq \"{memberId}\"]"
                    }
                }
            };

            await Http.PatchAsJsonAsync($"/scim/v2/Groups/{currentGroup.Id}", patchRequest);

            // Refresh the group
            var updatedGroup = await Http.GetFromJsonAsync<ScimGroup>($"/scim/v2/Groups/{currentGroup.Id}");
            if (updatedGroup != null)
            {
                currentGroup = updatedGroup;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing member from group");
        }
    }
}