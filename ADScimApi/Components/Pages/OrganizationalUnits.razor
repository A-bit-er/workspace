@page "/organizational-units"
@using ADScimApi.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ILogger<OrganizationalUnits> Logger

<PageTitle>Organizational Units</PageTitle>

<h1>Organizational Units</h1>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="() => ShowOUModal(new OrganizationalUnit())">Add New OU</button>
        <button class="btn btn-secondary ms-2" @onclick="SyncOUs">Sync from AD</button>
    </div>
</div>

@if (loading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (organizationalUnits == null || !organizationalUnits.Any())
{
    <div class="alert alert-info">No organizational units found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Distinguished Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ou in organizationalUnits)
                {
                    <tr>
                        <td>@ou.Name</td>
                        <td>@ou.DistinguishedName</td>
                        <td>@ou.Description</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => ShowOUModal(ou)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteOU(ou.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(currentOU.Id == 0 ? "Add New OU" : "Edit OU")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentOU" OnValidSubmit="SaveOU">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <InputText id="name" class="form-control" @bind-Value="currentOU.Name" />
                        </div>

                        <div class="mb-3">
                            <label for="distinguishedName" class="form-label">Distinguished Name</label>
                            <InputText id="distinguishedName" class="form-control" @bind-Value="currentOU.DistinguishedName" />
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <InputTextArea id="description" class="form-control" rows="3" @bind-Value="currentOU.Description" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<OrganizationalUnit>? organizationalUnits;
    private OrganizationalUnit currentOU = new();
    private bool showModal = false;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOUs();
    }

    private async Task LoadOUs()
    {
        loading = true;
        try
        {
            organizationalUnits = await Http.GetFromJsonAsync<List<OrganizationalUnit>>("/api/OrganizationalUnits");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading organizational units");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SyncOUs()
    {
        loading = true;
        try
        {
            await Http.PostAsync("/api/OrganizationalUnits/sync", null);
            await LoadOUs();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error syncing organizational units");
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowOUModal(OrganizationalUnit ou)
    {
        currentOU = ou;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task SaveOU()
    {
        try
        {
            if (currentOU.Id == 0)
            {
                // Create new OU
                await Http.PostAsJsonAsync("/api/OrganizationalUnits", currentOU);
            }
            else
            {
                // Update existing OU
                await Http.PutAsJsonAsync($"/api/OrganizationalUnits/{currentOU.Id}", currentOU);
            }

            CloseModal();
            await LoadOUs();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving organizational unit");
        }
    }

    private async Task DeleteOU(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this organizational unit?"))
        {
            return;
        }

        try
        {
            await Http.DeleteAsync($"/api/OrganizationalUnits/{id}");
            await LoadOUs();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting organizational unit");
        }
    }
}